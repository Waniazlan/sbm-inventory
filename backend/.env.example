APP_NAME="SBM Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5175
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5175,localhost:5175,127.0.0.1:8000
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sbm_inventory
DB_USERNAME=inventory_local
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=sbm_inventory_session
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
SHOP_TIMEZONE=Asia/Kuala_Lumpur
INVENTORY_SALES_TOKEN=
INVENTORY_REPAIR_TOKEN=

# Production uses these DigitalOcean settings; local/testing uses DB_* above.
DO_DB_HOST=
DO_DB_PORT=25060
DO_DB_DATABASE=sbm-inventory
DO_DB_USERNAME=
DO_DB_PASSWORD=
DO_DB_SSLMODE=require
DB_SEARCH_PATH=public

# Private login backgrounds (S3-compatible RustFS). Keep credentials server-side.
LOGIN_BACKGROUND_DISK=rustfs
RUSTFS_ENDPOINT=https://storage.thesparepart.my
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=sbm-inventory-private
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Central administrator sign-in. Register this instance in portal Settings → Single sign-on.
# Keep these disabled/blank until the exact client, branch and account links are configured.
SBM_SSO_ENABLED=false
SBM_SSO_ISSUER=
SBM_SSO_CLIENT_ID=
SBM_SSO_CLIENT_SECRET=
SBM_SSO_REDIRECT_URI=
SBM_SSO_APPLICATION_ID=
SBM_SSO_BRANCH_ID=
# Required for Tracking: explicit local shop mapped to the portal branch.
SBM_SSO_LOCAL_SHOP_ID=
